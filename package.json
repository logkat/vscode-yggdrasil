{
  "name": "git-yggdrasil",
  "displayName": "Yggdrasil Git Worktrees",
  "description": "Explore and switch git worktrees from the VS Code sidebar",
  "version": "0.1.5",
  "publisher": "LogKat",
  "license": "MIT",
  "icon": "./images/icon.png",
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "branch",
    "scm",
    "sidebar",
    "source-control",
    "ai-agents",
    "agentic"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:ygg.worktrees",
    "onView:ygg.worktrees.explorer",
    "onCommand:ygg.selectAndSwitch",
    "onCommand:ygg.welcome",
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/logkat/vscode-yggdrasil"
  },
  "bugs": {
    "url": "https://github.com/logkat/vscode-yggdrasil/issues"
  },
  "homepage": "http://yggdrasil.logkat.dev/",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Yggdrasil",
      "properties": {
        "ygg.showInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Show the Git Worktree Explorer in the explorer sidebar."
        },
        "ygg.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Branch to compare worktrees against. Leave empty to auto-detect the tracking branch (falls back to 'main')."
        }
      }
    },
    "colors": [
      {
        "id": "ygg.worktreeColor.current",
        "description": "Yggdrasil current worktree color",
        "defaults": {
          "dark": "#2f6f37",
          "light": "#30a147",
          "highContrast": "#30a147",
          "highContrastLight": "#30a147"
        }
      },
      {
        "id": "ygg.worktreeColor.1",
        "description": "Yggdrasil worktree color 1",
        "defaults": {
          "dark": "#9d615c",
          "light": "#9d615c",
          "highContrast": "#9d615c",
          "highContrastLight": "#9d615c"
        }
      },
      {
        "id": "ygg.worktreeColor.2",
        "description": "Yggdrasil worktree color 2",
        "defaults": {
          "dark": "#006edb",
          "light": "#001a47",
          "highContrast": "#006edb",
          "highContrastLight": "#006edb"
        }
      },
      {
        "id": "ygg.worktreeColor.3",
        "description": "Yggdrasil worktree color 3",
        "defaults": {
          "dark": "#866e04",
          "light": "#866e04",
          "highContrast": "#866e04",
          "highContrastLight": "#866e04"
        }
      },
      {
        "id": "ygg.worktreeColor.4",
        "description": "Yggdrasil worktree color 4",
        "defaults": {
          "dark": "#527a29",
          "light": "#527a29",
          "highContrast": "#527a29",
          "highContrastLight": "#527a29"
        }
      },
      {
        "id": "ygg.worktreeColor.5",
        "description": "Yggdrasil worktree color 5",
        "defaults": {
          "dark": "#eb670f",
          "light": "#984b10",
          "highContrast": "#eb670f",
          "highContrastLight": "#eb670f"
        }
      },
      {
        "id": "ygg.worktreeColor.6",
        "description": "Yggdrasil worktree color 6",
        "defaults": {
          "dark": "#a830e8",
          "light": "#ce2c85",
          "highContrast": "#ce2c85",
          "highContrastLight": "#ce2c85"
        }
      },
      {
        "id": "ygg.worktreeColor.7",
        "description": "Yggdrasil worktree color 7",
        "defaults": {
          "dark": "#106c70",
          "light": "#179b9b",
          "highContrast": "#179b9b",
          "highContrastLight": "#179b9b"
        }
      },
      {
        "id": "ygg.worktreeColor.8",
        "description": "Yggdrasil worktree color 8",
        "defaults": {
          "dark": "#895906",
          "light": "#b88700",
          "highContrast": "#b88700",
          "highContrastLight": "#b88700"
        }
      },
      {
        "id": "ygg.worktreeColor.9",
        "description": "Yggdrasil worktree color 9",
        "defaults": {
          "dark": "#894ceb",
          "light": "#894ceb",
          "highContrast": "#894ceb",
          "highContrastLight": "#894ceb"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yggdrasil-view",
          "title": "Git Worktree Explorer",
          "icon": "./images/worktree.svg"
        }
      ]
    },
    "views": {
      "yggdrasil-view": [
        {
          "id": "ygg.worktrees",
          "name": "Git Worktrees"
        }
      ],
      "explorer": [
        {
          "id": "ygg.worktrees.explorer",
          "name": "Git Worktrees (Explorer)",
          "when": "config.ygg.showInExplorer != false && yggdrasil.isReady"
        }
      ]
    },
    "commands": [
      {
        "command": "ygg.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ygg.switch",
        "title": "Switch Worktree",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ygg.selectAndSwitch",
        "title": "Switch Worktree...",
        "category": "ygg"
      },
      {
        "command": "ygg.clearSwitchMode",
        "title": "Clear Remembered Switch Mode",
        "category": "ygg"
      },
      {
        "command": "ygg.welcome",
        "title": "Welcome",
        "category": "ygg"
      },
      {
        "command": "ygg.add",
        "title": "Add Worktree",
        "category": "ygg",
        "icon": "$(add)"
      },
      {
        "command": "ygg.prune",
        "title": "Prune Missing Worktrees",
        "category": "ygg",
        "icon": "$(trash)"
      },
      {
        "command": "ygg.setBaseBranch",
        "title": "Set Base Branch...",
        "category": "ygg"
      },
      {
        "command": "ygg.remove",
        "title": "Remove Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "ygg.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "ygg.revealInOs",
        "title": "Reveal in Finder / Explorer"
      },
      {
        "command": "ygg.openDiff",
        "title": "Open Diff"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ygg.refresh",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        },
        {
          "command": "ygg.add",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        },
        {
          "command": "ygg.prune",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ygg.openDiff",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "ygg.switch",
          "when": "viewItem == worktreeItem || viewItem == worktreeItemVirtual",
          "group": "inline"
        },
        {
          "command": "ygg.switch",
          "when": "viewItem == worktreeItem || viewItem == worktreeItemVirtual",
          "group": "1_actions"
        },
        {
          "command": "ygg.prune",
          "when": "viewItem == worktreeItemMissing",
          "group": "1_actions"
        },
        {
          "command": "ygg.setBaseBranch",
          "when": "viewItem == worktreeItem || viewItem == worktreeItemCurrent",
          "group": "2_actions"
        },
        {
          "command": "ygg.remove",
          "when": "viewItem == worktreeItem",
          "group": "2_actions"
        },
        {
          "command": "ygg.copyPath",
          "when": "viewItem =~ /^worktreeItem/",
          "group": "3_actions"
        },
        {
          "command": "ygg.revealInOs",
          "when": "viewItem =~ /^worktreeItem/",
          "group": "3_actions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTests.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:local": "bash scripts/publish.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^10.3.0",
    "ovsx": "^0.10.6",
    "typescript": "^5.3.3"
  }
}
