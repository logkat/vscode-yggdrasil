{
  "name": "git-yggdrasil",
  "displayName": "Yggdrasil Git Worktrees",
  "description": "Explore and switch git worktrees from the VS Code sidebar",
  "version": "0.1.5",
  "publisher": "LogKat",
  "license": "MIT",
  "icon": "./images/icon.png",
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "branch",
    "scm",
    "sidebar",
    "source-control",
    "ai-agents",
    "agentic"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:ygg.worktrees",
    "onView:ygg.worktrees.explorer",
    "onCommand:ygg.selectAndSwitch",
    "onCommand:ygg.welcome",
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/logkat/vscode-yggdrasil"
  },
  "bugs": {
    "url": "https://github.com/logkat/vscode-yggdrasil/issues"
  },
  "homepage": "http://yggdrasil.logkat.dev/",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Yggdrasil",
      "properties": {
        "ygg.showInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Show the Git Worktree Explorer in the explorer sidebar."
        },
        "ygg.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Branch to compare worktrees against. Leave empty to auto-detect the tracking branch (falls back to 'main')."
        },
        "ygg.agentProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude-code",
            "claude-desktop"
          ],
          "description": "Which agent providers are active. Built-in values: \"claude-code\", \"claude-desktop\". Remove an entry to disable that provider."
        },
        "ygg.showAgentNodeWhenEmpty": {
          "type": "boolean",
          "default": false,
          "description": "Show the Agent Sessions child node even when no sessions are detected for a worktree."
        },
        "ygg.worktreeColors": {
          "type": "boolean",
          "default": false,
          "description": "Colour each worktree's rows, and the files and folders inside it, with a distinct colour."
        }
      }
    },
    "colors": [
      {
        "id": "ygg.worktreeColor.current",
        "description": "Yggdrasil current worktree color",
        "defaults": {
          "dark": "#60bc6b",
          "light": "#216e31",
          "highContrast": "#30a147",
          "highContrastLight": "#227232"
        }
      },
      {
        "id": "ygg.worktreeColor.1",
        "description": "Yggdrasil worktree color 1",
        "defaults": {
          "dark": "#c5a09d",
          "light": "#86534f",
          "highContrast": "#b07d78",
          "highContrastLight": "#8b5652"
        }
      },
      {
        "id": "ygg.worktreeColor.2",
        "description": "Yggdrasil worktree color 2",
        "defaults": {
          "dark": "#5caeff",
          "light": "#001a47",
          "highContrast": "#1189ff",
          "highContrastLight": "#0062c4"
        }
      },
      {
        "id": "ygg.worktreeColor.3",
        "description": "Yggdrasil worktree color 3",
        "defaults": {
          "dark": "#caa606",
          "light": "#735f03",
          "highContrast": "#a48705",
          "highContrastLight": "#786204"
        }
      },
      {
        "id": "ygg.worktreeColor.4",
        "description": "Yggdrasil worktree color 4",
        "defaults": {
          "dark": "#7dba3e",
          "light": "#476a24",
          "highContrast": "#669733",
          "highContrastLight": "#4a6e25"
        }
      },
      {
        "id": "ygg.worktreeColor.5",
        "description": "Yggdrasil worktree color 5",
        "defaults": {
          "dark": "#f4904d",
          "light": "#984b10",
          "highContrast": "#eb670f",
          "highContrastLight": "#a5490b"
        }
      },
      {
        "id": "ygg.worktreeColor.6",
        "description": "Yggdrasil worktree color 6",
        "defaults": {
          "dark": "#d08ff3",
          "light": "#b02672",
          "highContrast": "#dc5ba2",
          "highContrastLight": "#b62776"
        }
      },
      {
        "id": "ygg.worktreeColor.7",
        "description": "Yggdrasil worktree color 7",
        "defaults": {
          "dark": "#1cbbc2",
          "light": "#106b6b",
          "highContrast": "#179b9b",
          "highContrastLight": "#116f6f"
        }
      },
      {
        "id": "ygg.worktreeColor.8",
        "description": "Yggdrasil worktree color 8",
        "defaults": {
          "dark": "#e9970a",
          "light": "#7c5b00",
          "highContrast": "#b88700",
          "highContrastLight": "#805e00"
        }
      },
      {
        "id": "ygg.worktreeColor.9",
        "description": "Yggdrasil worktree color 9",
        "defaults": {
          "dark": "#bb98f3",
          "light": "#7730e8",
          "highContrast": "#a170ef",
          "highContrastLight": "#7b36e9"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yggdrasil-view",
          "title": "Git Worktree Explorer",
          "icon": "./images/worktree.svg"
        }
      ]
    },
    "views": {
      "yggdrasil-view": [
        {
          "id": "ygg.worktrees",
          "name": "Git Worktrees"
        }
      ],
      "explorer": [
        {
          "id": "ygg.worktrees.explorer",
          "name": "Git Worktrees (Explorer)",
          "when": "config.ygg.showInExplorer != false && yggdrasil.isReady"
        }
      ]
    },
    "commands": [
      {
        "command": "ygg.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ygg.switch",
        "title": "Switch Worktree",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ygg.selectAndSwitch",
        "title": "Switch Worktree...",
        "category": "ygg"
      },
      {
        "command": "ygg.clearSwitchMode",
        "title": "Clear Remembered Switch Mode",
        "category": "ygg"
      },
      {
        "command": "ygg.welcome",
        "title": "Welcome",
        "category": "ygg"
      },
      {
        "command": "ygg.add",
        "title": "Add Worktree",
        "category": "ygg",
        "icon": "$(add)"
      },
      {
        "command": "ygg.prune",
        "title": "Prune Missing Worktrees",
        "category": "ygg",
        "icon": "$(trash)"
      },
      {
        "command": "ygg.setBaseBranch",
        "title": "Set Base Branch...",
        "category": "ygg"
      },
      {
        "command": "ygg.remove",
        "title": "Remove Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "ygg.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "ygg.revealInOs",
        "title": "Reveal in Finder / Explorer"
      },
      {
        "command": "ygg.openDiff",
        "title": "Open Diff"
      },
      {
        "command": "ygg.copyAgentResumeCommand",
        "title": "Copy Resume Command"
      },
      {
        "command": "ygg.copyAgentSessionId",
        "title": "Copy Session ID"
      },
      {
        "command": "ygg.detectAgentProviders",
        "title": "Detect Installed Agents",
        "category": "ygg"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ygg.refresh",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        },
        {
          "command": "ygg.add",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        },
        {
          "command": "ygg.prune",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ygg.openDiff",
          "when": "false"
        },
        {
          "command": "ygg.copyAgentResumeCommand",
          "when": "false"
        },
        {
          "command": "ygg.copyAgentSessionId",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "ygg.switch",
          "when": "viewItem == worktreeItem || viewItem == worktreeItemVirtual",
          "group": "inline"
        },
        {
          "command": "ygg.switch",
          "when": "viewItem == worktreeItem || viewItem == worktreeItemVirtual",
          "group": "1_actions"
        },
        {
          "command": "ygg.prune",
          "when": "viewItem == worktreeItemMissing",
          "group": "1_actions"
        },
        {
          "command": "ygg.setBaseBranch",
          "when": "viewItem == worktreeItem || viewItem == worktreeItemCurrent",
          "group": "2_actions"
        },
        {
          "command": "ygg.remove",
          "when": "viewItem == worktreeItem",
          "group": "2_actions"
        },
        {
          "command": "ygg.copyPath",
          "when": "viewItem =~ /^worktreeItem/",
          "group": "3_actions"
        },
        {
          "command": "ygg.revealInOs",
          "when": "viewItem =~ /^worktreeItem/",
          "group": "3_actions"
        },
        {
          "command": "ygg.copyAgentResumeCommand",
          "when": "viewItem == agentSessionItemCli",
          "group": "1_actions"
        },
        {
          "command": "ygg.copyAgentSessionId",
          "when": "viewItem =~ /^agentSessionItem/",
          "group": "1_actions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTests.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:local": "bash scripts/publish.sh",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:dry-run": "commit-and-tag-version --dry-run"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.7.6",
    "ovsx": "^1.0.1",
    "prettier": "^3.8.4",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
