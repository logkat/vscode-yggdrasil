{
  "name": "yggdrasil",
  "displayName": "Yggdrasil — Git Worktree Explorer",
  "description": "Explore and switch git worktrees from the VS Code sidebar",
  "version": "0.1.0",
  "publisher": "yggdrasil",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yggdrasil-view",
          "title": "Git Worktree Explorer",
          "icon": "./images/worktree.svg"
        }
      ]
    },
    "views": {
      "yggdrasil-view": [
        {
          "id": "ygg.worktrees",
          "name": "Git Worktrees"
        }
      ],
      "explorer": [
        {
          "id": "ygg.worktrees.explorer",
          "name": "Git Worktrees (Explorer)",
          "when": "config.ygg.showInExplorer != false"
        }
      ]
    },
    "commands": [
      {
        "command": "ygg.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ygg.switch",
        "title": "Switch Worktree",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ygg.selectAndSwitch",
        "title": "Switch Worktree...",
        "category": "ygg"
      },
      {
        "command": "ygg.clearSwitchMode",
        "title": "Clear Remembered Switch Mode",
        "category": "ygg"
      },
      {
        "command": "ygg.welcome",
        "title": "Welcome",
        "category": "ygg"
      },
      {
        "command": "ygg.add",
        "title": "Add Worktree",
        "category": "ygg",
        "icon": "$(add)"
      },
      {
        "command": "ygg.remove",
        "title": "Remove Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "ygg.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "ygg.revealInOs",
        "title": "Reveal in Finder / Explorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ygg.refresh",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        },
        {
          "command": "ygg.add",
          "when": "view == ygg.worktrees || view == ygg.worktrees.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ygg.switch",
          "when": "viewItem == worktreeItem",
          "group": "inline"
        },
        {
          "command": "ygg.switch",
          "when": "viewItem == worktreeItem",
          "group": "1_actions"
        },
        {
          "command": "ygg.remove",
          "when": "viewItem == worktreeItem",
          "group": "2_actions"
        },
        {
          "command": "ygg.copyPath",
          "when": "viewItem =~ /^worktreeItem/",
          "group": "3_actions"
        },
        {
          "command": "ygg.revealInOs",
          "when": "viewItem =~ /^worktreeItem/",
          "group": "3_actions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTests.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}