# Copy to .env for local publishing (scripts/publish.sh).
# GitHub Actions uses repository secrets instead — do not commit .env.

# Azure DevOps PAT with Marketplace > Manage scope
# https://code.visualstudio.com/api/working-with-extensions/publishing-extension
VSCE_PAT=

# Open VSX access token
# https://open-vsx.org/user-settings/tokens
OVSX_PAT=
